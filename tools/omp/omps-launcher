#!/bin/bash
# omps-launcher — omps 上位互換ランチャー (Seatbelt + Git worktree + 起動時限定読み取り)
#
# 設計方針:
#   * 既存 ~/.omp/sandbox/omp-sandboxed は変更しない。--print-profile（ラッパーの
#     先頭引数）で生成された SBPL をそのまま基礎ポリシーとして使い、読み取り専用の
#     追加ルールだけを「dotenv 保護ブロックの直前」に挿入したポリシーを起動時に生成する。
#   * 追加するのは読み取り許可・既存 network 権限の限定復元・追加ルート限定 deny のみ。
#     file-write* の追加許可は一切生成しない（生成したら内部エラーで中止する）。
#   * 挿入位置を dotenv deny より前にすることで、.env の読み取り禁止は追加パス配下でも維持される
#     （SBPL は後勝ちなので、後ろに追記すると deny を上書きしてしまう）。
#   * sandbox-exec の適用に失敗したら中止する。Sandbox なしの omp へはフォールバックしない。
#
# 追加機能:
#   A. Git worktree 検出 — rev-parse のみ使用（Git の書き込み操作は行わない）。
#      通常リポジトリと linked worktree を区別し、Git 管理領域が workspace 外に
#      ある場合 *だけ* 読み取りを追加する。書き込みは追加しない。
#   B. 親ディレクトリのメタデータ — Git 管理領域/追加読み取り先へ到達するために
#      必要な中間ディレクトリにだけ file-read-metadata (literal ...) を追加する。
#      file-read* へは拡張しない。/Users/hart 全体の読み書き許可は付与しない。
#   C. 起動時限定の読み取り — OMPS_EXTRA_READ="/a:/b" で明示指定されたパスのみ。
#      実パス正規化・存在確認・シンボリックリンク解決・機密パス拒否（無条件）。
#   D. 登録 worktree / 親 AGENTS.md — git worktree list（読み取りのみ）で列挙・検証し、
#      通常ファイルは read-only 追加。socket/機密子孫は追加ルート限定 deny。失敗時は全自動 root を無効化。
#
# 環境変数:
#   OMP_SANDBOX_YOLO=1            --auto-approve を付与（omps 関数が既定で 1 を渡す）
#   OMPS_AWS_MODE=1               既存挙動: ~/.aws の読み取りを許可（CONFIRM_SENSITIVE_READ=1）
#   OMPS_EXTRA_READ="a:b"         起動時限定の追加読み取り（機密パスは拒否）
#   OMP_SANDBOX_PASS_ENV          既存挙動: クリーン環境へ転送する変数（HERDR 等）
#   OMPS_LAUNCHER_VERBOSE=1       起動計画を stderr に出力
#   OMPS_GIT_GLOBAL_CONFIG=read   グローバル gitconfig (~/.gitconfig, ~/.config/git/config) を
#                                 明示的に読み取り許可する。既定は許可せず、代わりに
#                                 GIT_CONFIG_GLOBAL=/dev/null を渡して git の読み取り系を動かす
#                                 （$HOME の設定ファイルから権限を自動拡大しないため）。
#   OMP_SANDBOX_INHERIT_ENV=1     既存ラッパーと同じ抜け道（非推奨・警告あり）
#   OMP_SANDBOX_SKIP_HOME_VERIFY=1 既存ラッパーと同じ抜け道（非推奨）
#
# サブコマンド（先頭引数のみ・omp へは転送しない）:
#   --print-plan     正規化済みの起動計画を KEY=VALUE で出力
#   --print-profile  合成後の SBPL ポリシーを出力
#   --launcher-help  この説明（--help は omp へ転送するので横取りしない）
#
# 互換性: Apple 標準 /bin/bash 3.2 で動作（連想配列・mapfile 不使用）。
set -euo pipefail

MODE=launch
case "${1:-}" in
  --print-profile) MODE=profile ;;
  --print-plan) MODE=plan ;;
  --launcher-help) MODE=help ;;
esac

die() { printf 'omps-launcher: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'omps-launcher: warning: %s\n' "$*" >&2; }

if [ "$MODE" = help ]; then
  /usr/bin/sed -n '2,44p' "$0" | /usr/bin/sed 's/^# \{0,1\}//'
  exit 0
fi

# ---------------------------------------------------------------- 0. 前提確認
[ -x /usr/bin/sandbox-exec ] || die "/usr/bin/sandbox-exec が見つかりません（macOS が必要）"
[ -x /usr/bin/env ] || die "/usr/bin/env が見つかりません"
OMP_BIN="$(command -v omp || true)"
[ -n "$OMP_BIN" ] || die "'omp' が PATH 上にありません"

# ------------------------------------------------- 1. HOME を dscl から解決
# 継承 $HOME の汚染による読み取り拒否ポリシーの迂回を防ぐ（既存ラッパーと同じ方式）。
_dscl_raw="$(/usr/bin/dscl . -read "/Users/$(/usr/bin/id -un)" NFSHomeDirectory 2>/dev/null)" || true
HOME_DIR=""
case "$_dscl_raw" in
  "NFSHomeDirectory: "*)
    _cand="${_dscl_raw#NFSHomeDirectory: }"
    [ -d "$_cand" ] || die "dscl が返したホーム '$_cand' が存在しません"
    HOME_DIR="$(cd "$_cand" && pwd -P)" ;;
esac
if [ -z "$HOME_DIR" ]; then
  if [ "${OMP_SANDBOX_SKIP_HOME_VERIFY:-0}" = "1" ]; then
    warn "dscl によるホーム解決に失敗。継承 HOME を使用（OMP_SANDBOX_SKIP_HOME_VERIFY=1）"
    HOME_DIR="$(cd "${HOME:?HOME is unset}" && pwd -P)"
  else
    die "ホームを /usr/bin/dscl で検証できませんでした（OMP_SANDBOX_SKIP_HOME_VERIFY=1 で回避可・非推奨）"
  fi
fi
if [ "${HOME:-}" != "$HOME_DIR" ]; then
  if [ "${OMP_SANDBOX_SKIP_HOME_VERIFY:-0}" = "1" ]; then
    warn "継承 HOME ('${HOME:-}') が実ホーム '$HOME_DIR' と異なります — 実ホームを使用"
  else
    die "継承 HOME ('${HOME:-}') が実ホーム '$HOME_DIR' と異なります — ポリシー迂回防止のため中止"
  fi
fi
export HOME="$HOME_DIR"

SANDBOXED="$HOME_DIR/.omp/sandbox/omp-sandboxed"
OMP_CONFIG="$HOME_DIR/.omp/agent/sandbox.yml"
[ -x "$SANDBOXED" ] || die "ラッパーが見つかりません: $SANDBOXED"
[ -f "$OMP_CONFIG" ] || die "OmP 設定が見つかりません: $OMP_CONFIG"

# 既存ラッパー側の追加許可を直接指定された場合は拒否（本ランチャーは write 拡大を扱わない）。
if [ -n "${OMP_SANDBOX_EXTRA_WRITE:-}" ]; then
  die "OMP_SANDBOX_EXTRA_WRITE は本ランチャーでは扱いません（write 拡大は禁止）。読み取りは OMPS_EXTRA_READ を使用してください"
fi
if [ -n "${OMP_SANDBOX_EXTRA_READ:-}" ]; then
  die "OMP_SANDBOX_EXTRA_READ ではなく OMPS_EXTRA_READ を使用してください（委譲時のみ内部で使用）"
fi

# -------------------------------------------------------- 2. workspace 決定
if ! _wt="$(/usr/bin/git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "Error: Git repository の中で実行してください"
  exit 1
fi
[ -n "$_wt" ] && [ -d "$_wt" ] || die "Git リポジトリルートを解決できません"
WORKSPACE="$(cd "$_wt" && pwd -P)"
if [ "$WORKSPACE" = "/" ] || [ "$WORKSPACE" = "$HOME_DIR" ]; then
  [ "${OMP_SANDBOX_CONFIRM_WIDE:-0}" = "1" ] || \
    die "workspace '$WORKSPACE' は広すぎます（OMP_SANDBOX_CONFIRM_WIDE=1 で明示承認）"
  warn "workspace '$WORKSPACE' — 広範なアクセスを OMP_SANDBOX_CONFIRM_WIDE=1 で承認済み"
fi

# TMPDIR は既存ラッパーと同じ検証・正規化を行う（clean env とポリシーの一致のため）。
_tmpdir_raw="$(cd "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P || echo '/private/tmp')"
case "$_tmpdir_raw" in
  /private/tmp|/private/tmp/*|/private/var/folders/*) TMPDIR_CANON="$_tmpdir_raw" ;;
  *) warn "TMPDIR ('$_tmpdir_raw') は既知の一時領域ではありません — /private/tmp をポリシーに使用"
     TMPDIR_CANON="/private/tmp" ;;
esac
export TMPDIR="$TMPDIR_CANON"

# --------------------------------------------- 3. Git worktree / 管理領域の検出
# rev-parse のみ（読み取り専用）。書き込み系 Git 操作は一切行わない。
GIT_DIR="$(/usr/bin/git rev-parse --absolute-git-dir 2>/dev/null || true)"
[ -n "$GIT_DIR" ] || die "Git 管理ディレクトリを検出できません（git rev-parse --absolute-git-dir）"

GIT_COMMON_DIR="$(/usr/bin/git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -z "$GIT_COMMON_DIR" ]; then
  GIT_COMMON_DIR="$(/usr/bin/git rev-parse --git-common-dir 2>/dev/null || true)"
  case "$GIT_COMMON_DIR" in
    /*) : ;;
    ?*) GIT_COMMON_DIR="$PWD/$GIT_COMMON_DIR" ;;
  esac
fi
[ -n "$GIT_COMMON_DIR" ] || die "Git 共通管理ディレクトリを検出できません"

[ -d "$GIT_DIR" ] || die "Git 管理ディレクトリが実在しません: $GIT_DIR"
[ -d "$GIT_COMMON_DIR" ] || die "Git 共通管理ディレクトリが実在しません: $GIT_COMMON_DIR"
GIT_DIR="$(cd "$GIT_DIR" && pwd -P)"
GIT_COMMON_DIR="$(cd "$GIT_COMMON_DIR" && pwd -P)"

if [ "$GIT_DIR" = "$GIT_COMMON_DIR" ]; then
  GIT_LAYOUT="repository"
else
  GIT_LAYOUT="linked-worktree"
fi

_under() {  # _under PATH ROOT — PATH が ROOT 自身または配下なら 0
  local _p="$1" _r="$2"
  [ "$_r" = "/" ] && return 0
  _r="${_r%/}"
  case "${_p%/}/" in "${_r}/"*) return 0 ;; esac
  return 1
}

_overlaps() {  # _overlaps A B — どちらかが他方を包含（同一含む）
  _under "$1" "$2" || _under "$2" "$1"
}

_display_path() {  # 制御文字を含む untrusted path を安全に 1 行表示
  printf '%s' "$1" | /usr/bin/tr '\001-\037\177' '?'
}

_canon_path() {  # 既存パスを実パスへ。失敗時 1（未存在・相対・制御文字・不正解決）
  local _p="$1" _out
  case "$_p" in
    *$'\n'*|*$'\r'*|*$'\t'*|*[[:cntrl:]]*) return 1 ;;
    /*) : ;;
    *) return 1 ;;
  esac
  [ -e "$_p" ] || return 1
  _out="$(/usr/bin/readlink -f "$_p" 2>/dev/null)" || return 1
  [ -n "$_out" ] || return 1
  case "$_out" in
    *$'\n'*|*$'\r'*|*$'\t'*|*[[:cntrl:]]*) return 1 ;;
  esac
  printf '%s\n' "$_out"
}

# 登録 worktree の列挙結果（未検証）。flags<TAB>path を 1 行ずつ保持する。
WORKTREE_ENUM="untrusted"
WORKTREE_LIST=""
WORKTREE_CANDIDATES=""
_worktree_skips=""
_wt_tab="$(printf '\t')"
_wt_parse_ok=1
_wt_have_worktree=0
_wt_cur_path=""
_wt_cur_flags=""
_wt_count=0

_wt_skip() {  # PATH REASON — 候補単位のスキップ（列挙全体は継続）
  _worktree_skips="${_worktree_skips}$(_display_path "$1"):$2
"
  warn "worktree をスキップ: '$(_display_path "$1")' (reason: $2)"
}

_wt_emit_record() {  # porcelain 1 レコードを確定（空行/NUL 区切り・次レコード開始）
  [ "$_wt_have_worktree" = 1 ] || return 0
  _wt_have_worktree=0
  if [ -z "$_wt_cur_path" ]; then
    _wt_parse_ok=0
    return 0
  fi
  case "$_wt_cur_path" in
    *$'\n'*|*$'\r'*|*$'\t'*|*[[:cntrl:]]*)
      _wt_skip "$_wt_cur_path" control-char
      return 0 ;;
    /*) : ;;
    *)
      _wt_skip "$_wt_cur_path" not-absolute
      return 0 ;;
  esac
  WORKTREE_LIST="${WORKTREE_LIST}${_wt_cur_flags}${_wt_tab}${_wt_cur_path}
"
  _wt_count=$((_wt_count + 1))
  return 0
}

_wt_enum_failed() {
  WORKTREE_ENUM="untrusted"
  warn "Git worktree 列挙を検証できないため、登録 worktree の自動読み取りをすべて無効化します"
}

# ------------------------------------- 3b. 登録 worktree の列挙（git 読み取りのみ）
# 外部の GIT_* 環境や gitconfig に影響されないよう env -i で完全に隔離する。
# -z（NUL 区切り）を使い、改行を含むパスによる行注入を防ぐ。
_wt_tmpfile="$(/usr/bin/mktemp -t omps-launcher-worktrees 2>/dev/null || true)"
if [ -n "$_wt_tmpfile" ]; then
  if /usr/bin/env -i \
      "HOME=$HOME_DIR" "TMPDIR=$TMPDIR_CANON" \
      "PATH=/usr/bin:/bin:/usr/sbin:/sbin" "LANG=C" "LC_ALL=C" \
      "GIT_CONFIG_NOSYSTEM=1" "GIT_CONFIG_GLOBAL=/dev/null" \
      "GIT_CONFIG_SYSTEM=/dev/null" "GIT_TERMINAL_PROMPT=0" \
      "GIT_OPTIONAL_LOCKS=0" \
      /usr/bin/git -C "$WORKSPACE" worktree list --porcelain -z \
      >"$_wt_tmpfile" 2>/dev/null; then
    while IFS= read -r -d '' _tok; do
      case "$_tok" in
        "worktree "*)
          _wt_emit_record
          _wt_cur_path="${_tok#worktree }"
          _wt_cur_flags=""
          _wt_have_worktree=1 ;;
        "HEAD "*) : ;;
        "branch "*|"detached") : ;;
        "bare") _wt_cur_flags="${_wt_cur_flags}bare," ;;
        "locked"|"locked "*) _wt_cur_flags="${_wt_cur_flags}locked," ;;
        "prunable"|"prunable "*) _wt_cur_flags="${_wt_cur_flags}prunable," ;;
        "") _wt_emit_record ;;
        *) _wt_parse_ok=0 ;;
      esac
    done <"$_wt_tmpfile"
    _wt_emit_record
    if [ "$_wt_parse_ok" = 1 ] && [ "$_wt_count" -gt 0 ]; then
      WORKTREE_ENUM="ok"
    else
      _wt_enum_failed
    fi
  else
    _wt_enum_failed
  fi
  /bin/rm -f "$_wt_tmpfile"
else
  _wt_enum_failed
fi

# ------------------------------------------------- 4. 追加読み取り（Git 管理領域）
# workspace 外 かつ $HOME 配下のときだけ意味がある（$HOME 外は allow default で読める）。
GIT_OUTSIDE_WS=0
_under "$GIT_DIR" "$WORKSPACE" || GIT_OUTSIDE_WS=1

GIT_READ_ROOTS=""
if [ "$GIT_OUTSIDE_WS" = 1 ]; then
  if _under "$GIT_DIR" "$GIT_COMMON_DIR"; then
    _add_git_roots="$GIT_COMMON_DIR"        # 共通管理領域が git-dir を包含（linked worktree）
  else
    _add_git_roots="$GIT_COMMON_DIR
$GIT_DIR"
  fi
  while IFS= read -r _r; do
    [ -n "$_r" ] || continue
    if ! _under "$_r" "$HOME_DIR"; then continue; fi   # $HOME 外は追加不要
    GIT_READ_ROOTS="${GIT_READ_ROOTS}${_r}
"
  done <<EOF
$_add_git_roots
EOF
  GIT_READ_ROOTS="$(printf '%s' "$GIT_READ_ROOTS" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"
fi

# --------------------------------------------- 5. 追加読み取り（起動時明示指定）
sb_escape() {  # SBPL 文字列リテラル用エスケープ。安全に扱えないパスは拒否。
  local _s
  case "$1" in
    *$'\n'*|*$'\r'*|*$'\t'*|*[[:cntrl:]]*)
      die "パスに制御文字が含まれるためポリシーを安全に生成できません: '$1'" ;;
  esac
  _s="${1//\\/\\\\}"
  printf '%s' "${_s//\"/\\\"}"
}

_omps_sensitive_roots() {  # 1 行 1 パス。空白入りパスも安全に列挙する。
  printf '%s\n' \
    "$HOME_DIR/.ssh" "$HOME_DIR/.aws" "$HOME_DIR/.gnupg" \
    "$HOME_DIR/.netrc" "$HOME_DIR/.netrc.gpg" "$HOME_DIR/.git-credentials" \
    "$HOME_DIR/.password-store" "$HOME_DIR/.kube" "$HOME_DIR/.docker" \
    "$HOME_DIR/.npmrc" "$HOME_DIR/.pypirc" "$HOME_DIR/.config/gcloud" \
    "$HOME_DIR/.config/gh" "$HOME_DIR/.config/op" \
    "$HOME_DIR/.local/share/keyrings" \
    "$HOME_DIR/Library/Keychains" "$HOME_DIR/Library/LaunchAgents" \
    "$HOME_DIR/Library/Cookies" "$HOME_DIR/Library/Safari" \
    "$HOME_DIR/Library/Messages" "$HOME_DIR/Library/Mobile Documents" \
    "$HOME_DIR/Library/Application Support/Google" \
    "$HOME_DIR/.zshrc" "$HOME_DIR/.zprofile" "$HOME_DIR/.zshenv" \
    "$HOME_DIR/.zsh_history" "$HOME_DIR/.bashrc" "$HOME_DIR/.bash_profile" \
    "$HOME_DIR/.profile" "$HOME_DIR/.bash_history"
}

_omps_sensitive_path() {  # 0 = 機密（無条件拒否対象・字句判定）
  local _p="$1" _s _rest
  case "$_p" in
    "/"|"$HOME_DIR") return 0 ;;
  esac
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    case "$_s/" in "$_p"/*) return 0 ;; esac   # 機密領域の祖先
    case "$_p/" in "$_s"/*) return 0 ;; esac   # 機密領域の配下
  done <<EOF
$(_omps_sensitive_roots)
EOF
  _rest="/${_p#/}/"
  case "$_rest" in
    */.ssh/*|*/.aws/*|*/.gnupg/*|*/.netrc/*|*/Keychains/*|*/.password-store/*|*/.git-credentials/*|*/.kube/*|*/.docker/*|*/.config/gcloud/*)
      return 0 ;;
  esac
  return 1
}

_omps_sensitive_resolved() {  # 0 = 機密（シンボリックリンク解決後も含む）
  local _p="$1" _s
  _omps_sensitive_path "$_p" && return 0
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    _overlaps "$_p" "$_s" && return 0
  done <<EOF
$_OMPS_SENSITIVE_RESOLVED
EOF
  return 1
}

_omps_sensitive_inside() {  # 0 = 候補自身が機密（または機密の配下/字句祖先）
  local _p="$1" _s
  _omps_sensitive_path "$_p" && return 0
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    _under "$_p" "$_s" && return 0
  done <<EOF
$_OMPS_SENSITIVE_RESOLVED
EOF
  return 1
}

_omps_collect_sensitive_descendants() {  # 候補が包含する解決済み機密パスを deny 対象に積む
  local _p="$1" _s
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    if _under "$_s" "$_p"; then
      WT_PROTECTED_DENIES="${WT_PROTECTED_DENIES}${_s}
"
    fi
  done <<EOF
$_OMPS_SENSITIVE_RESOLVED
EOF
}

_omps_collect_gitconfig_descendants() {  # 既定で読まないグローバル gitconfig を候補内だけ deny
  local _p="$1" _gc _gcc
  while IFS= read -r _gc; do
    [ -n "$_gc" ] || continue
    _gcc="$(_canon_path "$_gc" || true)"
    [ -n "$_gcc" ] || _gcc="$_gc"
    if _under "$_gcc" "$_p"; then
      WT_PROTECTED_DENIES="${WT_PROTECTED_DENIES}${_gcc}
"
    fi
  done <<EOF
$HOME_DIR/.gitconfig
$HOME_DIR/.config/git
EOF
}

# 起動時に一度だけ機密パスの実体を解決してキャッシュ（毎候補の再解決を避ける）。
_OMPS_SENSITIVE_RESOLVED=""
while IFS= read -r _s; do
  [ -n "$_s" ] || continue
  [ -e "$_s" ] || [ -L "$_s" ] || continue
  _r="$(_canon_path "$_s" || true)"
  [ -n "$_r" ] || continue
  _OMPS_SENSITIVE_RESOLVED="${_OMPS_SENSITIVE_RESOLVED}${_r}
"
done <<EOF
$(_omps_sensitive_roots)
EOF
_OMPS_SENSITIVE_RESOLVED="$(printf '%s' "$_OMPS_SENSITIVE_RESOLVED" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"

_meta_literals=""
_add_meta_ancestors() {  # $1 = 追加読み取り先。親を $HOME 手前まで metadata-only で許可。
  local _a
  _a="$(/usr/bin/dirname "$1")"
  while [ "$_a" != "/" ] && _under "$_a" "$HOME_DIR"; do
    [ "$_a" = "$HOME_DIR" ] && break                    # $HOME ノードは基礎ポリシーで許可済み
    if ! _under "$_a" "$WORKSPACE" && ! _under "$_a" "$HOME_DIR/.omp"; then
      _meta_literals="${_meta_literals}${_a}
"
    fi
    _a="$(/usr/bin/dirname "$_a")"
  done
}

EXTRA_READ_ROOTS=""
if [ -n "${OMPS_EXTRA_READ:-}" ]; then
  _oldifs="$IFS"
  IFS=':'
  set -f
  _er_list=($OMPS_EXTRA_READ)
  set +f
  IFS="$_oldifs"
  _er_n=0
  for _raw in ${_er_list[@]+"${_er_list[@]}"}; do
    [ -n "$_raw" ] || continue
    case "$_raw" in
      "~") _raw="$HOME_DIR" ;;
      "~/"*) _raw="$HOME_DIR/${_raw#\~/}" ;;
    esac
    case "$_raw" in
      /*) : ;;
      *) die "OMPS_EXTRA_READ は絶対パスで指定してください: '$_raw'" ;;
    esac
    case "$_raw" in
      */../*|*/..|../*|..) die "OMPS_EXTRA_READ に '..' を含むパスは許可しません: '$_raw'" ;;
    esac
    if [ ! -e "$_raw" ] && [ ! -L "$_raw" ]; then
      die "OMPS_EXTRA_READ のパスが存在しません（fail closed）: '$_raw'"
    fi
    if [ -L "$_raw" ]; then
      _canon="$(/usr/bin/readlink -f "$_raw" 2>/dev/null || true)"
      [ -n "$_canon" ] || die "シンボリックリンクを解決できません（fail closed）: '$_raw'"
    elif _canon="$(cd "$_raw" 2>/dev/null && pwd -P)"; then
      :
    else
      _canon="$(cd "$(/usr/bin/dirname "$_raw")" 2>/dev/null && pwd -P)/$(/usr/bin/basename "$_raw")" || \
        die "実パスへ正規化できません（fail closed）: '$_raw'"
    fi
    [ -n "${_canon:-}" ] || die "実パスへ正規化できません（fail closed）: '$_raw'"
    _canon="${_canon%/}"
    [ "$_canon" = "/" ] && die "OMPS_EXTRA_READ=/ は許可しません"
    if _omps_sensitive_path "$_canon"; then
      die "OMPS_EXTRA_READ に機密パスは指定できません（無条件拒否）: '$_raw' -> '$_canon'"
    fi
    EXTRA_READ_ROOTS="${EXTRA_READ_ROOTS}${_canon}
"
    _er_n=$((_er_n + 1))
  done
  [ "$_er_n" -gt 0 ] || die "OMPS_EXTRA_READ が空です（未指定と同じ扱いにはしません）"
  EXTRA_READ_ROOTS="$(printf '%s' "$EXTRA_READ_ROOTS" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"
fi

# ---------------- 5b. グローバル gitconfig（明示オプトイン時のみ literal 許可）
# 既定では $HOME の設定ファイルを自動的に読み取り許可しない。その代わり既定で
# GIT_CONFIG_GLOBAL=/dev/null を渡し、git の読み取り系（status/rev-parse/log）を動かす。
# OMPS_GIT_GLOBAL_CONFIG=read を指定した場合のみ、当該ファイル *1個* の literal 読み取りを追加する。
_literal_read_sources=""
GIT_GLOBAL_MODE="${OMPS_GIT_GLOBAL_CONFIG:-none}"
case "$GIT_GLOBAL_MODE" in
  none|read) : ;;
  *) die "OMPS_GIT_GLOBAL_CONFIG は 'read' のみ指定できます: '$GIT_GLOBAL_MODE'" ;;
esac
if [ "$GIT_GLOBAL_MODE" = "read" ]; then
  for _c in "$HOME_DIR/.gitconfig" "$HOME_DIR/.config/git/config"; do
    [ -f "$_c" ] || continue
    _real="$(/usr/bin/readlink -f "$_c" 2>/dev/null || true)"
    [ -n "$_real" ] || _real="$_c"
    if _omps_sensitive_path "$_real"; then
      die "グローバル gitconfig の実体が機密領域を指しています: '$_real'"
    fi
    _literal_read_sources="${_literal_read_sources}${_real}
"
  done
  [ -n "$_literal_read_sources" ] || warn "OMPS_GIT_GLOBAL_CONFIG=read ですがグローバル gitconfig が見つかりません"
else
  # 設定ファイルを読ませない（権限は増やさない）。$HOME の既定 ignore/attributes も
  # 読めないため /dev/null へ向けて警告ノイズを抑える（none モードのみ）。
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0=core.excludesFile
  export GIT_CONFIG_VALUE_0=/dev/null
  export GIT_CONFIG_KEY_1=core.attributesFile
  export GIT_CONFIG_VALUE_1=/dev/null
fi

# --------------------------------- 6. AWS モード / 環境変数転送（既存実装の再現）
PASS_ENV="HERDR_ENV:HERDR_BIN_PATH:HERDR_PANE_ID:HERDR_SOCKET_PATH:HERDR_TAB_ID:HERDR_WORKSPACE_ID"
BASE_EXTRA_READ=""
BASE_CONFIRM_READ=0
AWS_MODE=0
if [ "${OMPS_AWS_MODE:-0}" = "1" ]; then
  AWS_MODE=1
  BASE_EXTRA_READ="$HOME_DIR/.aws"        # 既存挙動: Bedrock 用に ~/.aws を読み取り許可
  BASE_CONFIRM_READ=1
else
  # 既存挙動: 通常時は AWS 認証情報を遮断
  export AWS_SHARED_CREDENTIALS_FILE=/dev/null
  export AWS_CONFIG_FILE=/dev/null
  PASS_ENV="$PASS_ENV:AWS_SHARED_CREDENTIALS_FILE:AWS_CONFIG_FILE"
fi
if [ "$GIT_GLOBAL_MODE" = "none" ]; then
  # git が $HOME 配下の gitconfig / 既定 ignore を読まないようにする（読み取り権限は増やさない）
  PASS_ENV="$PASS_ENV:GIT_CONFIG_GLOBAL:GIT_CONFIG_COUNT:GIT_CONFIG_KEY_0:GIT_CONFIG_VALUE_0:GIT_CONFIG_KEY_1:GIT_CONFIG_VALUE_1"
fi
export OMP_SANDBOX_PASS_ENV="$PASS_ENV"

# ------------------------- 6b. 登録 worktree / 親 AGENTS.md の検証と追加ルート決定
_wt_note() {  # PATH REASON — 計画にだけ残す（正常系のスキップは警告しない）
  _worktree_skips="${_worktree_skips}$(_display_path "$1"):$2
"
}

_git_in_repo() {  # DIR ARGS... — 外部 GIT_* 環境を排除して読み取り専用 git を実行
  local _dir="$1"; shift
  /usr/bin/env -i \
    "HOME=$HOME_DIR" "TMPDIR=$TMPDIR_CANON" \
    "PATH=/usr/bin:/bin:/usr/sbin:/sbin" "LANG=C" "LC_ALL=C" \
    "GIT_CONFIG_NOSYSTEM=1" "GIT_CONFIG_GLOBAL=/dev/null" \
    "GIT_CONFIG_SYSTEM=/dev/null" "GIT_TERMINAL_PROMPT=0" \
    "GIT_OPTIONAL_LOCKS=0" \
    /usr/bin/git -C "$_dir" "$@"
}

_wt_meta_mismatch() {  # PATH — 共有メタデータの相互リンクを含む検証
  local _cand="$1" _common _top _gitdir _line _linked _back _expect
  if [ ! -e "$_cand/.git" ]; then return 0; fi
  if [ ! -f "$_cand/.git" ] && [ ! -d "$_cand/.git" ]; then return 0; fi
  _common="$(_git_in_repo "$_cand" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  _top="$(_git_in_repo "$_cand" rev-parse --show-toplevel 2>/dev/null || true)"
  _gitdir="$(_git_in_repo "$_cand" rev-parse --absolute-git-dir 2>/dev/null || true)"
  [ -n "$_common" ] && [ -n "$_top" ] && [ -n "$_gitdir" ] || return 0
  _common="$(_canon_path "$_common" || true)"
  _top="$(_canon_path "$_top" || true)"
  _gitdir="$(_canon_path "$_gitdir" || true)"
  [ "$_common" = "$GIT_COMMON_DIR" ] || return 0
  [ "$_top" = "$_cand" ] || return 0
  if [ "$_gitdir" != "$GIT_COMMON_DIR" ] && ! _under "$_gitdir" "$GIT_COMMON_DIR"; then
    return 0
  fi
  # linked worktree は .git ファイルと共有 worktrees/<id>/gitdir の両方が必要
  if [ "$_gitdir" != "$GIT_COMMON_DIR" ]; then
    [ -f "$_cand/.git" ] || return 0
    [ -f "$_gitdir/gitdir" ] || return 0
  fi
  # linked worktree の .git ファイル → 共有 worktrees/<id> の逆方向リンクを確認
  if [ -f "$_cand/.git" ] && [ ! -L "$_cand/.git" ]; then
    _line="$(/usr/bin/head -n 1 "$_cand/.git" 2>/dev/null || true)"
    case "$_line" in
      "gitdir: "*) _linked="${_line#gitdir: }" ;;
      *) return 0 ;;
    esac
    case "$_linked" in
      /*) : ;;
      *) _linked="$_cand/$_linked" ;;
    esac
    _linked="$(_canon_path "$_linked" || true)"
    [ "$_linked" = "$_gitdir" ] || return 0
  fi
  if [ -f "$_gitdir/gitdir" ]; then
    _back="$(/usr/bin/head -n 1 "$_gitdir/gitdir" 2>/dev/null || true)"
    case "$_back" in
      /*) : ;;
      ?*) _back="$_gitdir/$_back" ;;   # relative-paths worktree metadata
    esac
    _expect="$(_canon_path "$_cand/.git" || true)"
    _back="$(_canon_path "$_back" || true)"
    [ -n "$_back" ] && [ "$_back" = "$_expect" ] || return 0
  fi
  return 1  # 0 = mismatch, 1 = OK
}

WT_READ_ROOTS=""
WT_DENY_ROOTS=""
WT_PROTECTED_DENIES=""
_worktree_auto_roots=0
_wt_current_found=0

if [ "$WORKTREE_ENUM" = "ok" ]; then
  _oldifs="$IFS"
  IFS=$'\n'
  set -f
  _wt_records=($WORKTREE_LIST)
  set +f
  IFS="$_oldifs"
  for _rec in ${_wt_records[@]+"${_wt_records[@]}"}; do
    [ -n "$_rec" ] || continue
    _flags="${_rec%%"$_wt_tab"*}"
    _raw="${_rec#*"$_wt_tab"}"
    _cand="$(_canon_path "$_raw" || true)"
    if [ -n "$_cand" ]; then
      WORKTREE_CANDIDATES="${WORKTREE_CANDIDATES}${_cand}
"
    else
      WORKTREE_CANDIDATES="${WORKTREE_CANDIDATES}$(_display_path "$_raw")
"
    fi
    case ",$_flags," in
      *,bare,*) _wt_skip "$_raw" bare; continue ;;
    esac
    case ",$_flags," in
      *,prunable,*) _wt_skip "$_raw" prunable; continue ;;
    esac
    case "$_raw" in
      *$'\n'*|*$'\r'*|*$'\t'*|*[[:cntrl:]]*) _wt_skip "$_raw" control-char; continue ;;
      /*) : ;;
      *) _wt_skip "$_raw" not-absolute; continue ;;
    esac
    [ -n "$_cand" ] || { _wt_skip "$_raw" missing; continue; }
    [ -d "$_cand" ] || { _wt_skip "$_cand" not-directory; continue; }
    if [ "$_cand" = "$WORKSPACE" ]; then
      _wt_current_found=1
      _wt_note "$_cand" current
      continue
    fi
    if ! _under "$_cand" "$HOME_DIR"; then
      _wt_note "$_cand" outside-home
      continue
    fi
    if _omps_sensitive_inside "$_cand"; then
      _wt_skip "$_cand" sensitive
      continue
    fi
    # dotenv 保護はファイル名基準。worktree ルート自体が .env 系ディレクトリの場合、
    # 配下の読み取りが保護を迂回し得るため追加しない（fail closed）。
    case "${_cand}/" in
      *"/.env/"*|*"/.env."*"/"*) _wt_skip "$_cand" sensitive; continue ;;
    esac
    if _overlaps "$_cand" "$WORKSPACE"; then
      _wt_skip "$_cand" workspace-overlap
      continue
    fi
    _wt_meta_ok=1
    while IFS= read -r _g; do
      [ -n "$_g" ] || continue
      if _under "$_cand" "$_g"; then _wt_meta_ok=0; break; fi
    done <<EOF
$GIT_READ_ROOTS
EOF
    if [ "$_wt_meta_ok" = 0 ]; then
      _wt_skip "$_cand" git-metadata-overlap
      continue
    fi
    _wt_ov=0
    while IFS= read -r _o; do
      [ -n "$_o" ] || continue
      if _overlaps "$_cand" "$_o"; then _wt_ov=1; break; fi
    done <<EOF
$EXTRA_READ_ROOTS
EOF
    if [ "$_wt_ov" = 1 ]; then
      _wt_skip "$_cand" extra-read-overlap
      continue
    fi
    if [ -n "$BASE_EXTRA_READ" ] && _overlaps "$_cand" "$BASE_EXTRA_READ"; then
      _wt_skip "$_cand" aws-overlap
      continue
    fi
    if _overlaps "$_cand" "$HOME_DIR/.omp"; then
      _wt_skip "$_cand" omp-config-overlap
      continue
    fi
    # 既定モードで読まないグローバル gitconfig の「配下」に入る候補は追加しない。
    # 候補が gitconfig を「包含」する場合は、そのパスだけ後で scoped deny する。
    _wt_gc_inside=0
    while IFS= read -r _gc; do
      [ -n "$_gc" ] || continue
      _gcc="$(_canon_path "$_gc" || true)"
      [ -n "$_gcc" ] || _gcc="$_gc"
      if _under "$_cand" "$_gc" || _under "$_cand" "$_gcc"; then _wt_gc_inside=1; break; fi
    done <<EOF
$HOME_DIR/.gitconfig
$HOME_DIR/.config/git
EOF
    if [ "$_wt_gc_inside" = 1 ]; then
      _wt_skip "$_cand" gitconfig-overlap
      continue
    fi
    _wt_ov=0
    while IFS= read -r _o; do
      [ -n "$_o" ] || continue
      if _overlaps "$_cand" "$_o"; then _wt_ov=1; break; fi
    done <<EOF
$_literal_read_sources
EOF
    if [ "$_wt_ov" = 1 ]; then
      _wt_skip "$_cand" gitconfig-overlap
      continue
    fi
    if _wt_meta_mismatch "$_cand"; then
      _wt_skip "$_cand" metadata-mismatch
      continue
    fi
    # 追加が確定したルートについてのみ、内包する解決済み機密/gitconfig を
    # scoped deny に積む（スキップ候補の deny が既存許可へ漏れないようにする）。
    _omps_collect_sensitive_descendants "$_cand"
    _omps_collect_gitconfig_descendants "$_cand"
    WT_READ_ROOTS="${WT_READ_ROOTS}${_cand}
"
    WT_DENY_ROOTS="${WT_DENY_ROOTS}${_cand}
"
  done
fi

if [ "$WORKTREE_ENUM" = "ok" ] && [ "$_wt_current_found" = 0 ]; then
  _wt_enum_failed
fi
if [ "$WORKTREE_ENUM" != "ok" ]; then
  WT_READ_ROOTS=""
  WT_DENY_ROOTS=""
  WT_PROTECTED_DENIES=""
fi
WT_READ_ROOTS="$(printf '%s' "$WT_READ_ROOTS" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"
WT_DENY_ROOTS="$(printf '%s' "$WT_DENY_ROOTS" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"
WT_PROTECTED_DENIES="$(printf '%s' "$WT_PROTECTED_DENIES" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"
# 保護 deny は必ず追加ルートの内側だけを対象にする（既存許可を狭めない）。
if [ -n "$WT_PROTECTED_DENIES" ]; then
  while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    _prot_ok=0
    while IFS= read -r _root; do
      [ -n "$_root" ] || continue
      if _under "$_p" "$_root"; then _prot_ok=1; break; fi
    done <<EOF
$WT_READ_ROOTS
EOF
    [ "$_prot_ok" = 1 ] || \
      die "内部エラー: 保護 deny が追加ルートの外側にあります: '$_p'"
  done <<EOF
$WT_PROTECTED_DENIES
EOF
fi
_worktree_auto_roots="$(printf '%s\n' "$WT_READ_ROOTS" | /usr/bin/grep -c . || true)"

# 親 AGENTS.md（workspace の祖先・$HOME を含む・workspace 自身は除外）
PARENT_AGENT_FILES=""
PARENT_AGENT_SKIPS=""
_agents_parent_skip() {
  PARENT_AGENT_SKIPS="${PARENT_AGENT_SKIPS}$(_display_path "$1"):$2
"
  warn "親 AGENTS.md をスキップ: '$(_display_path "$1")' (reason: $2)"
}
_agents_d="$(/usr/bin/dirname "$WORKSPACE")"
while _under "$_agents_d" "$HOME_DIR"; do
  _af="$_agents_d/AGENTS.md"
  if [ -L "$_af" ]; then
    _agents_parent_skip "$_af" symlink
  elif [ -f "$_af" ]; then
    _af_real="$(_canon_path "$_af" || true)"
    if [ -z "$_af_real" ] || [ "$_af_real" != "$_af" ] || _omps_sensitive_resolved "$_af"; then
      _agents_parent_skip "$_af" sensitive
    else
      PARENT_AGENT_FILES="${PARENT_AGENT_FILES}${_af}
"
    fi
  fi
  [ "$_agents_d" = "$HOME_DIR" ] && break
  _agents_next="$(/usr/bin/dirname "$_agents_d")"
  [ "$_agents_next" = "$_agents_d" ] && break
  _agents_d="$_agents_next"
done
PARENT_AGENT_FILES="$(printf '%s' "$PARENT_AGENT_FILES" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"

# 到達に必要な中間ディレクトリの metadata のみ許可（readdir 不可）
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  _add_meta_ancestors "$_r"
done <<EOF
$GIT_READ_ROOTS
EOF
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  _add_meta_ancestors "$_r"
done <<EOF
$EXTRA_READ_ROOTS
$WT_READ_ROOTS
EOF
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  _add_meta_ancestors "$_r"
done <<EOF
$_literal_read_sources
$PARENT_AGENT_FILES
EOF
_meta_literals="$(printf '%s' "$_meta_literals" | /usr/bin/sort -u | /usr/bin/sed '/^$/d')"

# --------------------------------------------------- 7. 基礎ポリシーの生成
# --print-profile はラッパーの先頭引数に渡す（--config の後ろに置くと omp へ転送され失敗する）。
BASE_PROFILE="$(/usr/bin/env \
    "OMP_SANDBOX_WORKSPACE=$WORKSPACE" \
    "OMP_SANDBOX_EXTRA_READ=$BASE_EXTRA_READ" \
    "OMP_SANDBOX_CONFIRM_SENSITIVE_READ=$BASE_CONFIRM_READ" \
    "$SANDBOXED" --print-profile)" || die "基礎ポリシーの生成に失敗しました（omp-sandboxed --print-profile）"
[ -n "$BASE_PROFILE" ] || die "基礎ポリシーが空です"

# ------------------------------------------- 8. 追加ルール（読み取りのみ）の合成
# 追加 deny が既存許可を狭めないことを、生成前に再確認する（多重防御）。
while IFS= read -r _root; do
  [ -n "$_root" ] || continue
  while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    if _overlaps "$_root" "$_p"; then
      die "内部エラー: worktree 追加ルートが既存許可と重なっています: '$_root'"
    fi
  done <<EOF
$WORKSPACE
$EXTRA_READ_ROOTS
$BASE_EXTRA_READ
$HOME_DIR/.omp
$_literal_read_sources
EOF
  while IFS= read -r _g; do
    [ -n "$_g" ] || continue
    if _under "$_root" "$_g"; then
      die "内部エラー: worktree 追加ルートが既存許可と重なっています: '$_root'"
    fi
  done <<EOF
$GIT_READ_ROOTS
EOF
done <<EOF
$WT_DENY_ROOTS
EOF

_read_subpaths=""
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  _esc="$(sb_escape "$_r")" || die "パスをエスケープできません: '$_r'"
  _read_subpaths="${_read_subpaths}    (subpath \"${_esc}\")
"
done <<EOF
$(printf '%s\n%s\n%s' "$GIT_READ_ROOTS" "$EXTRA_READ_ROOTS" "$WT_READ_ROOTS" | /usr/bin/sed '/^$/d')
EOF
_read_literals=""
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  _esc="$(sb_escape "$_r")" || die "パスをエスケープできません: '$_r'"
  _read_literals="${_read_literals}    (literal \"${_esc}\")
"
done <<EOF
$(printf '%s\n%s' "$_literal_read_sources" "$PARENT_AGENT_FILES" | /usr/bin/sed '/^$/d')
EOF
_meta_out=""
while IFS= read -r _r; do
  [ -n "$_r" ] || continue
  case "$_r" in *"/.env"|*"/.env."*) die "メタデータ許可の対象に .env を含められません: '$_r'" ;; esac
  _esc="$(sb_escape "$_r")" || die "パスをエスケープできません: '$_r'"
  _meta_out="${_meta_out}    (literal \"${_esc}\")
"
done <<EOF
$_meta_literals
EOF

# 追加 worktree ルート限定の socket / 機密子孫 deny。パス述語なので、
# ポリシー生成後に作られた socket にも適用される（スキャンではない）。
# 追加ルートは workspace/EXTRA_READ/AWS/.omp/gitconfig と重ならないことを上で確認済み。
#
# SBPL は 1 ルール内に並置した複数フィルタを OR として解釈する
# （例: base プロファイルの (allow file-read* (subpath A) (subpath B)) は
#  A または B の許可）。したがって「ルート配下の socket」だけを対象にするには、
# (subpath ...) と (vnode-type SOCKET) を require-all で交差させなければならない。
# 素の並置 (deny file-read* (subpath R) (vnode-type SOCKET)) は
# 「R 配下の全ファイル」または「全 socket」の拒否となり、追加 worktree の
# 通常ファイル読み取りまで壊す（実際にその形で全 worktree 読み取りが失敗した）。
# 復元 allow 側も同じ理由で require-all 必須: 並置すると全 socket の読み取りを
# システム全体で許可してしまい、socket deny 自体を無効化する。
_wt_socket_denies=""
while IFS= read -r _root; do
  [ -n "$_root" ] || continue
  _esc="$(sb_escape "$_root")" || die "パスをエスケープできません: '$_root'"
  _wt_socket_denies="${_wt_socket_denies}(deny file-read* (require-all (subpath \"${_esc}\") (vnode-type SOCKET)))
(deny network-outbound (subpath \"${_esc}\"))
(deny network-bind (subpath \"${_esc}\"))
"
  # 追加ルートが既存の Git 管理領域を包含する場合（main worktree の .git など）、
  # 既存の読み取り/network 権限を狭めないよう、その部分だけ deny の後で復元する。
  while IFS= read -r _g; do
    [ -n "$_g" ] || continue
    _under "$_g" "$_root" || continue
    _gesc="$(sb_escape "$_g")" || die "パスをエスケープできません: '$_g'"
    _wt_socket_denies="${_wt_socket_denies}(allow file-read* (require-all (subpath \"${_gesc}\") (vnode-type SOCKET)))
(allow network-outbound (subpath \"${_gesc}\"))
(allow network-bind (subpath \"${_gesc}\"))
"
  done <<EOF
$GIT_READ_ROOTS
EOF
done <<EOF
$WT_DENY_ROOTS
EOF

# ネストされた認証情報と一般的な秘密鍵も、追加 worktree の内側だけで拒否する。
_wt_nested_denies=""
while IFS= read -r _root; do
  [ -n "$_root" ] || continue
  _esc="$(sb_escape "$_root")" || die "パスをエスケープできません: '$_root'"
  _wt_nested_denies="${_wt_nested_denies}(deny file-read* (require-all (subpath \"${_esc}\") (regex #\".*/([.]ssh|[.]aws|[.]gnupg|[.]kube|[.]docker|[.]npmrc|[.]netrc|[.]git-credentials)(/.*)?$\")))
(deny file-read* (require-all (subpath \"${_esc}\") (regex #\".*/(id_rsa|id_dsa|id_ecdsa|id_ed25519|[^/]+[.](pem|key|p12|pfx))$\")))
"
done <<EOF
$WT_DENY_ROOTS
EOF

_wt_sensitive_denies=""
while IFS= read -r _rel; do
  [ -n "$_rel" ] || continue
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    _esc="$(sb_escape "${_root}/${_rel}")" || die "パスをエスケープできません: '${_root}/${_rel}'"
    _wt_sensitive_denies="${_wt_sensitive_denies}(deny file-read* (subpath \"${_esc}\"))
"
  done <<EOF
$WT_DENY_ROOTS
EOF
done <<EOF
.ssh
.aws
.gnupg
.netrc
.netrc.gpg
.git-credentials
.password-store
.kube
.docker
.npmrc
.pypirc
.config/gcloud
.config/gh
.config/op
.local/share/keyrings
Library/Keychains
Library/LaunchAgents
Library/Cookies
Library/Safari
Library/Messages
Library/Mobile Documents
Library/Application Support/Google
.zshrc
.zprofile
.zshenv
.zsh_history
.bashrc
.bash_profile
.profile
.bash_history
EOF

_wt_protected_denies_out=""
while IFS= read -r _p; do
  [ -n "$_p" ] || continue
  _esc="$(sb_escape "$_p")" || die "パスをエスケープできません: '$_p'"
  _wt_protected_denies_out="${_wt_protected_denies_out}(deny file-read* (subpath \"${_esc}\"))
"
done <<EOF
$WT_PROTECTED_DENIES
EOF

BLOCK=""
if [ -n "$_read_subpaths" ] || [ -n "$_read_literals" ]; then
  BLOCK="
;; --- omps-launcher: 読み取り専用の追加許可（Git 管理領域 / 登録 worktree / 親 AGENTS.md / 起動時指定） ---
;; write 許可は意図的に一切追加しない（linked worktree 上の git add/commit は失敗し得る）
(allow file-read*
${_read_subpaths}${_read_literals})"
fi
if [ -n "$_wt_socket_denies" ]; then
  BLOCK="${BLOCK}
;; --- omps-launcher: 追加 worktree の socket を拒否（追加ルート限定・後勝ち） ---
${_wt_socket_denies}"
fi
if [ -n "$_wt_sensitive_denies" ]; then
  BLOCK="${BLOCK}
;; --- omps-launcher: 追加 worktree 配下の機密子孫を拒否（追加ルート限定） ---
${_wt_sensitive_denies}"
fi
if [ -n "$_wt_nested_denies" ]; then
  BLOCK="${BLOCK}
;; --- omps-launcher: worktree 内の認証情報・秘密鍵の名前を拒否 ---
${_wt_nested_denies}"
fi
if [ -n "$_wt_protected_denies_out" ]; then
  BLOCK="${BLOCK}
;; --- omps-launcher: 解決済み機密パス / グローバル gitconfig を拒否（追加ルート内のみ） ---
${_wt_protected_denies_out}"
fi
# 既に Git 管理領域として読み取り許可されていた部分は、追加 worktree の
# scoped deny によって狭めない。dotenv deny はこの復元の後に適用される。
while IFS= read -r _root; do
  [ -n "$_root" ] || continue
  while IFS= read -r _g; do
    [ -n "$_g" ] && _under "$_g" "$_root" || continue
    _gesc="$(sb_escape "$_g")" || die "Git 管理領域をエスケープできません: '$_g'"
    BLOCK="${BLOCK}
(allow file-read* (subpath \"${_gesc}\"))"
  done <<EOF
$GIT_READ_ROOTS
EOF
done <<EOF
$WT_DENY_ROOTS
EOF
if [ -n "$_meta_out" ]; then
  BLOCK="${BLOCK}
;; --- omps-launcher: 親ディレクトリのメタデータのみ許可（到達用・readdir は不可） ---
(allow file-read-metadata
${_meta_out})"
fi
case "$BLOCK" in
  *"file-write"*) die "内部エラー: 書き込み許可を生成しようとしました — 中止します" ;;
esac
while [ "${BLOCK%$'\n'}" != "$BLOCK" ]; do BLOCK="${BLOCK%$'\n'}"; done

# 挿入位置: dotenv 保護ブロックの直前（後勝ちの SBPL で .env 禁止を維持するため）
_anchor=''
if printf '%s\n' "$BASE_PROFILE" | /usr/bin/grep -q '^;; --- dotenv protection ---'; then
  _anchor=';; --- dotenv protection ---'
elif printf '%s\n' "$BASE_PROFILE" | /usr/bin/grep -q '^;; --- home-node metadata'; then
  _anchor=';; --- home-node metadata'
else
  die "基礎ポリシーに挿入位置が見つかりません（フォーマット変更の可能性）— 中止します"
fi

MERGED=""
if [ -n "$BLOCK" ]; then
  _done=0
  while IFS= read -r _line || [ -n "$_line" ]; do
    if [ "$_done" = 0 ]; then
      case "$_line" in
        "$_anchor"*)
          MERGED="${MERGED}${BLOCK}
"
          _done=1 ;;
      esac
    fi
    MERGED="${MERGED}${_line}
"
  done <<EOF
$BASE_PROFILE
EOF
  [ "$_done" = 1 ] || die "内部エラー: 追加ルールを挿入できませんでした"
else
  MERGED="${BASE_PROFILE}
"
fi

PROFILE="$(/usr/bin/mktemp -t omps-launcher-profile)" || die "一時ポリシーファイルを作成できません"
/bin/chmod 600 "$PROFILE"
printf '%s' "$MERGED" > "$PROFILE"

# 古い一時ポリシーの掃除（1日以上前・自前プレフィックスのみ）
/usr/bin/find "$TMPDIR_CANON" -maxdepth 1 -name 'omps-launcher-profile.*' -mmin +180 \
  -exec /bin/rm -f {} \; 2>/dev/null || true

# ------------------------------------------- 9. ポリシー検証（fail closed）
# (a) SBPL として適用できるか（= Seatbelt が実効で有効になることの確認）
/usr/bin/sandbox-exec -f "$PROFILE" /usr/bin/true || \
  die "生成ポリシーを sandbox-exec で適用できません — 起動を中止します（Sandbox なしへはフォールバックしません）"
# (b) 権限が増えていないこと（write/deny の件数が基礎ポリシーと一致）
_cnt() { printf '%s\n' "$2" | /usr/bin/grep -c "$1" || true; }
_bw="$(/usr/bin/grep -c '(allow file-write\*' "$PROFILE" || true)"
_deny="$(/usr/bin/grep -c '^(deny ' "$PROFILE" || true)"
_bw_base="$(_cnt '^(allow file-write\*' "$BASE_PROFILE")"
_deny_base="$(_cnt '^(deny ' "$BASE_PROFILE")"
_bw_deny="$(_cnt '^(deny file-write' "$BASE_PROFILE")"
_bw_deny_final="$(/usr/bin/grep -c '^(deny file-write' "$PROFILE" || true)"
_blk_deny="$(printf '%s\n' "$BLOCK" | /usr/bin/grep -c '^(deny ' || true)"
[ -n "$_blk_deny" ] || _blk_deny=0
[ "$_bw" = "$_bw_base" ] || die "内部エラー: file-write* 許可の件数が変化しました ($_bw_base -> $_bw)"
[ "$_bw_deny_final" = "$_bw_deny" ] || die "内部エラー: file-write* deny の件数が変化しました ($_bw_deny -> $_bw_deny_final)"
[ "$_deny" = "$((_deny_base + _blk_deny))" ] || \
  die "内部エラー: deny ルールの件数が不整合です (base=$_deny_base block=$_blk_deny final=$_deny)"
# (c) 追加ブロックに行の種類が読み取り許可 / 追加ルート限定 deny 以外に無いこと（多重防御）。
#     挿入したブロックだけを検査する（base の deny file-write* と混同しないため）。
if [ -n "$BLOCK" ]; then
  _blk_bad=0
  while IFS= read -r _line; do
    case "$_line" in
      ''|';;'*|'(allow file-read*'|'(allow file-read-metadata'|'    (subpath "'*'")'|'    (literal "'*'")'|')' \
      |'(deny file-read* (require-all (subpath "'*'") (vnode-type SOCKET)))' \
      |'(deny network-outbound (subpath "'*'"))' \
      |'(deny network-bind (subpath "'*'"))' \
      |'(allow file-read* (require-all (subpath "'*'") (vnode-type SOCKET)))' \
      |'(allow network-outbound (subpath "'*'"))' \
      |'(allow network-bind (subpath "'*'"))' \
      |'(deny file-read* (require-all (subpath "'*'") (regex #"'*'")))' \
      |'(allow file-read* (subpath "'*'"))' \
      |'(deny file-read* (subpath "'*'"))') : ;;
      *) _blk_bad=1 ;;
    esac
    case "$_line" in *file-write*) _blk_bad=1 ;; esac
  done <<EOF
$BLOCK
EOF
  [ "$_blk_bad" = 0 ] || die "内部エラー: 追加ブロックに想定外のルールがあります — 中止します"
fi
# (d) 合成結果が「基礎ポリシー＋追加ブロック」に一致すること（行数の整合）
#   grep -c '' は末尾改行の有無に依存せず行数を数える。
_sz_merged="$(printf '%s' "$MERGED" | /usr/bin/grep -c '' || true)"
_sz_base="$(printf '%s' "$BASE_PROFILE" | /usr/bin/grep -c '' || true)"
_sz_block=0
if [ -n "$BLOCK" ]; then _sz_block="$(printf '%s' "$BLOCK" | /usr/bin/grep -c '' || true)"; fi
[ -n "$_sz_merged" ] || _sz_merged=0
[ -n "$_sz_base" ] || _sz_base=0
if [ "$_sz_merged" != "$((_sz_base + _sz_block))" ]; then
  die "内部エラー: 合成ポリシーの行数が不整合です (merged=$_sz_merged base=$_sz_base block=$_sz_block)"
fi

# ------------------------------------------------------------ 10. 起動計画出力
_plan() {
  printf 'OMPS_LAUNCHER=1\n'
  printf 'WORKSPACE=%s\n' "$WORKSPACE"
  printf 'GIT_LAYOUT=%s\n' "$GIT_LAYOUT"
  printf 'GIT_DIR=%s\n' "$GIT_DIR"
  printf 'GIT_COMMON_DIR=%s\n' "$GIT_COMMON_DIR"
  printf 'GIT_DIR_OUTSIDE_WORKSPACE=%s\n' "$GIT_OUTSIDE_WS"
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'GIT_READ_ROOT=%s\n' "$_r"; fi; done <<EOF
$GIT_READ_ROOTS
EOF
  printf 'WORKTREE_ENUM=%s\n' "$WORKTREE_ENUM"
  printf 'WORKTREE_AUTO_ROOTS=%s\n' "$_worktree_auto_roots"
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'WORKTREE_CANDIDATE=%s\n' "$_r"; fi; done <<EOF
$WORKTREE_CANDIDATES
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'WORKTREE_READ=%s\n' "$_r"; fi; done <<EOF
$WT_READ_ROOTS
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'WORKTREE_SKIP=%s\n' "$_r"; fi; done <<EOF
$_worktree_skips
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'SOCKET_GUARD=%s\n' "$_r"; fi; done <<EOF
$WT_DENY_ROOTS
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'PARENT_AGENTS=%s\n' "$_r"; fi; done <<EOF
$PARENT_AGENT_FILES
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'PARENT_AGENTS_SKIP=%s\n' "$_r"; fi; done <<EOF
$PARENT_AGENT_SKIPS
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'EXTRA_READ_PATH=%s\n' "$_r"; fi; done <<EOF
$EXTRA_READ_ROOTS
EOF
  while IFS= read -r _r; do if [ -n "$_r" ]; then printf 'METADATA_LITERAL=%s\n' "$_r"; fi; done <<EOF
$_meta_literals
EOF
  printf 'AWS_MODE=%s\n' "$AWS_MODE"
  printf 'CONFIRM_SENSITIVE_READ=%s\n' "$BASE_CONFIRM_READ"
  printf 'YOLO=%s\n' "$([ "${OMP_SANDBOX_YOLO:-0}" = 1 ] && echo 1 || echo 0)"
  printf 'PASS_ENV=%s\n' "$PASS_ENV"
  printf 'PROFILE=%s\n' "$PROFILE"
  printf 'PROFILE_LINES=%s\n' "$(/usr/bin/wc -l < "$PROFILE" | /usr/bin/tr -d ' ')"
  printf 'BASE_PROFILE_LINES=%s\n' "$(printf '%s\n' "$BASE_PROFILE" | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
}

case "$MODE" in
  plan)
    _plan
    /bin/rm -f "$PROFILE"
    exit 0 ;;
  profile)
    /bin/cat "$PROFILE"
    /bin/rm -f "$PROFILE"
    exit 0 ;;
esac

if [ "${OMPS_LAUNCHER_VERBOSE:-0}" = "1" ]; then
  _plan >&2
fi

# ------------------------------------------------------ 11. クリーン環境で起動
# 既存ラッパー _sbx_build_clean_env の再現（$HOME は検証済みの実ホームを使用）。
_build_clean_env() {
  local _sv _passval
  _clean_env=("HOME=$HOME_DIR" "TMPDIR=$TMPDIR_CANON" \
              "OMP_SANDBOX=seatbelt" "PI_SANDBOX=seatbelt")
  for _sv in PATH USER LOGNAME SHELL LANG LC_ALL LC_CTYPE LC_MESSAGES \
             TERM TERM_PROGRAM COLORTERM __CF_USER_TEXT_ENCODING COMMAND_MODE; do
    if [ -n "${!_sv:-}" ]; then _clean_env+=("$_sv=${!_sv}"); fi
  done
  if [ -n "${OMP_SANDBOX_PASS_ENV:-}" ]; then
    local _oldifs="$IFS"
    IFS=':'
    set -f
    local _pv=($OMP_SANDBOX_PASS_ENV)
    set +f
    IFS="$_oldifs"
    for _sv in ${_pv[@]+"${_pv[@]}"}; do
      [ -n "$_sv" ] || continue
      _passval="${!_sv:-}"
      if [ -n "$_passval" ]; then
        _clean_env+=("$_sv=$_passval")
      else
        warn "OMP_SANDBOX_PASS_ENV: '$_sv' は未設定または空です"
      fi
    done
  fi
  return 0
}

LAUNCH_ARGS=()
if [ "${OMP_SANDBOX_YOLO:-0}" = "1" ]; then
  LAUNCH_ARGS+=(--auto-approve)
fi

cd "$WORKSPACE" || die "workspace へ移動できません: $WORKSPACE"

if [ "${OMP_SANDBOX_INHERIT_ENV:-0}" = "1" ]; then
  warn "OMP_SANDBOX_INHERIT_ENV=1 — 親環境をそのまま渡します（非推奨）"
  exec /usr/bin/sandbox-exec -f "$PROFILE" "$OMP_BIN" \
    ${LAUNCH_ARGS[@]+"${LAUNCH_ARGS[@]}"} --config "$OMP_CONFIG" "$@"
fi

_build_clean_env
exec /usr/bin/env -i "${_clean_env[@]}" \
  /usr/bin/sandbox-exec -f "$PROFILE" "$OMP_BIN" \
  ${LAUNCH_ARGS[@]+"${LAUNCH_ARGS[@]}"} --config "$OMP_CONFIG" "$@"
